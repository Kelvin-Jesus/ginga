<?xml version="1.0" encoding="utf-8"?>
<!--
    Home (design/ginga-design/flows.md, "Tablet (Android)"): one StatusOrbit at the top, one
    decision at a time below it (MainActivity.render shows one panel for HomeModel.panel), the
    method chips, and the technical details collapsed in Diagnóstico.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/gingaBg">

    <!--
        Black espacial only: the dithered galaxy (DitherSpace) behind the header, faint so the text
        stays readable; GONE in the other themes.
    -->
    <dev.ginga.receiver.ui.widget.DitherSpaceView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="@dimen/ginga_space_4"
        android:alpha="0.4"
        app:ditherColumns="100"
        app:ditherRows="50"
        app:ditherScene="galaxy"
        app:spaceOnly="true" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:fillViewport="true"
        android:fitsSystemWindows="true">

        <dev.ginga.receiver.ui.widget.ColumnLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:padding="@dimen/screen_padding"
            app:maxColumnWidth="@dimen/home_column">

            <!--
                Header: monogram B + Ginga, the status, Settings. One line from 600dp wide
                (layout-w600dp/home_header.xml); on a phone in portrait the status goes below.
            -->
            <include layout="@layout/home_header" />

            <FrameLayout
                android:id="@+id/panels"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/home_panel_margin_top"
                android:clipChildren="false"
                android:minHeight="@dimen/home_panel_min_height">

                <!-- Procurando: title, the radar. -->
                <LinearLayout
                    android:id="@+id/panel_searching"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Ginga.Text.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:accessibilityHeading="true"
                            android:text="@string/home_searching_title" />

                        <TextView
                            style="@style/Ginga.Text.BodyMuted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ginga_space_1"
                            android:text="@string/home_searching_sub" />
                    </LinearLayout>

                    <dev.ginga.receiver.ui.widget.RadarView
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_marginStart="@dimen/home_radar_margin_start"
                        android:layout_marginEnd="@dimen/home_radar_margin_end" />
                </LinearLayout>

                <!-- Mac encontrado: the Macs on the network, one DeviceRow each. -->
                <LinearLayout
                    android:id="@+id/panel_found"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/Ginga.Text.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:text="@string/home_found_title" />

                    <TextView
                        style="@style/Ginga.Text.BodyMuted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ginga_space_1"
                        android:text="@string/home_found_sub" />

                    <LinearLayout
                        android:id="@+id/mac_list"
                        style="@style/Widget.Ginga.Group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ginga_space_4" />

                    <TextView
                        style="@style/Ginga.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ginga_space_4"
                        android:layout_marginTop="@dimen/ginga_space_2"
                        android:layout_marginEnd="@dimen/ginga_space_4"
                        android:text="@string/home_found_hint" />
                </LinearLayout>

                <!-- Cabo USB. -->
                <LinearLayout
                    android:id="@+id/panel_usb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/usb_title"
                        style="@style/Ginga.Text.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true" />

                    <TextView
                        android:id="@+id/usb_sub"
                        style="@style/Ginga.Text.BodyMuted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ginga_space_1" />

                    <Button
                        android:id="@+id/usb_connect"
                        style="@style/Widget.Ginga.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_marginTop="@dimen/ginga_space_6"
                        android:text="@string/usb_connect" />

                    <TextView
                        style="@style/Ginga.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ginga_space_4"
                        android:text="@string/usb_adb_hint" />
                </LinearLayout>

                <!-- Sem roteador (§6b). -->
                <LinearLayout
                    android:id="@+id/panel_direct"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/Ginga.Text.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:text="@string/direct_title" />

                    <TextView
                        style="@style/Ginga.Text.BodyMuted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ginga_space_1"
                        android:text="@string/direct_sub" />

                    <TextView
                        android:id="@+id/direct_status"
                        style="@style/Ginga.Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ginga_space_4"
                        android:accessibilityLiveRegion="polite" />

                    <Button
                        android:id="@+id/direct"
                        style="@style/Widget.Ginga.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_marginTop="@dimen/ginga_space_6"
                        android:text="@string/direct_start" />

                    <Button
                        android:id="@+id/direct_cancel"
                        style="@style/Widget.Ginga.Button"
                        android:layout_width="wrap_content"
                        android:layout_marginTop="@dimen/ginga_space_6"
                        android:text="@string/direct_cancel" />
                </LinearLayout>

                <!-- Pareando: the same six digits on both screens. -->
                <LinearLayout
                    android:id="@+id/panel_pairing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/pairing_title"
                        style="@style/Ginga.Text.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:gravity="center" />

                    <dev.ginga.receiver.ui.widget.PairingCodeView
                        android:id="@+id/pairing_code"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ginga_space_6" />

                    <TextView
                        android:id="@+id/pairing_sub"
                        style="@style/Ginga.Text.BodyMuted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ginga_space_4"
                        android:accessibilityLiveRegion="polite"
                        android:gravity="center" />

                    <!-- One line, or two when they don't fit (FlowLayout). -->
                    <dev.ginga.receiver.ui.widget.FlowLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ginga_space_6"
                        app:flowCenter="true"
                        app:flowGap="@dimen/ginga_space_2">

                        <Button
                            android:id="@+id/pairing_reject"
                            style="@style/Widget.Ginga.Button"
                            android:layout_width="wrap_content"
                            android:text="@string/pairing_dont" />

                        <Button
                            android:id="@+id/pairing_accept"
                            style="@style/Widget.Ginga.Button.Primary"
                            android:layout_width="wrap_content"
                            android:text="@string/pairing_pair" />
                    </dev.ginga.receiver.ui.widget.FlowLayout>
                </LinearLayout>

                <!-- Conectando. -->
                <LinearLayout
                    android:id="@+id/panel_connecting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/connecting_title"
                        style="@style/Ginga.Text.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true" />

                    <TextView
                        android:id="@+id/connecting_detail"
                        style="@style/Ginga.Text.BodyMuted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ginga_space_1" />

                    <Button
                        android:id="@+id/connecting_cancel"
                        style="@style/Widget.Ginga.Button"
                        android:layout_width="wrap_content"
                        android:layout_marginTop="@dimen/ginga_space_6"
                        android:text="@string/disconnect" />
                </LinearLayout>

                <!-- Conectado / Pausado. -->
                <LinearLayout
                    android:id="@+id/panel_connected"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/connected_title"
                        style="@style/Ginga.Text.Display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true" />

                    <TextView
                        android:id="@+id/connected_sub"
                        style="@style/Ginga.Text.BodyMuted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ginga_space_2" />

                    <TextView
                        android:id="@+id/connected_specs"
                        style="@style/Ginga.Text.MonoMuted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ginga_space_2" />

                    <dev.ginga.receiver.ui.widget.FlowLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ginga_space_6"
                        app:flowGap="@dimen/ginga_space_2">

                        <Button
                            android:id="@+id/open_stream"
                            style="@style/Widget.Ginga.Button.Primary"
                            android:layout_width="wrap_content"
                            android:text="@string/open_stream" />

                        <Button
                            android:id="@+id/disconnect"
                            style="@style/Widget.Ginga.Button.Danger"
                            android:layout_width="wrap_content"
                            android:text="@string/disconnect" />
                    </dev.ginga.receiver.ui.widget.FlowLayout>
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/notice"
                style="@style/Ginga.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ginga_space_6"
                android:accessibilityLiveRegion="polite"
                android:drawablePadding="@dimen/ginga_space_2"
                android:visibility="gone" />

            <!-- Method chips: Wi‑Fi · Cabo USB · Sem roteador (wrapping when they don't fit). -->
            <dev.ginga.receiver.ui.widget.FlowLayout
                android:id="@+id/chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ginga_space_8"
                app:flowGap="@dimen/ginga_space_2">

                <TextView
                    android:id="@+id/chip_wifi"
                    style="@style/Widget.Ginga.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chip_wifi" />

                <TextView
                    android:id="@+id/chip_usb"
                    style="@style/Widget.Ginga.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chip_usb" />

                <TextView
                    android:id="@+id/chip_direct"
                    style="@style/Widget.Ginga.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chip_direct" />
            </dev.ginga.receiver.ui.widget.FlowLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="@dimen/ginga_space_12" />

            <!-- Diagnóstico, collapsed: the technical line (codec, ports, adb). -->
            <LinearLayout
                android:id="@+id/diagnostics_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/g_btn_ghost"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/g_focus_ring"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ginga_space_1"
                android:paddingEnd="@dimen/ginga_space_4">

                <TextView
                    style="@style/Ginga.Text.GroupTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="0dp"
                    android:layout_weight="1"
                    android:text="@string/diagnostics_title" />

                <TextView
                    android:id="@+id/diagnostics_action"
                    style="@style/Ginga.Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/details_show"
                    android:textColor="?attr/gingaCobalt" />
            </LinearLayout>

            <TextView
                android:id="@+id/diagnostics_text"
                style="@style/Ginga.Text.MonoMuted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ginga_space_2"
                android:background="@drawable/g_code_block"
                android:padding="@dimen/ginga_space_4"
                android:textIsSelectable="true"
                android:visibility="gone" />
        </dev.ginga.receiver.ui.widget.ColumnLayout>
    </ScrollView>

    <!--
        Sem roteador, in progress (flows.md): its own screen over cosmos (#000 in Black espacial)
        with the dithered galaxy turning, the network's name in mono and star, and Encerrar.
    -->
    <FrameLayout
        android:id="@+id/direct_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/gingaSky"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone">

        <dev.ginga.receiver.ui.widget.DitherSpaceView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="-40dp"
            android:layout_marginEnd="-48dp"
            android:layout_marginBottom="@dimen/direct_galaxy_margin_bottom"
            app:ditherColumns="140"
            app:ditherRows="140"
            app:ditherScene="galaxy" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fitsSystemWindows="true">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="@dimen/screen_padding">

                <TextView
                    android:id="@+id/direct_ssid"
                    style="@style/Ginga.Text.Mono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:textColor="@color/ginga_star_dark"
                    android:textIsSelectable="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Ginga.Text.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:accessibilityHeading="true"
                            android:text="@string/direct_title"
                            android:textColor="@color/ginga_stardust_dark" />

                        <TextView
                            android:id="@+id/direct_screen_line"
                            style="@style/Ginga.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ginga_space_1"
                            android:accessibilityLiveRegion="polite"
                            android:textColor="@color/ginga_ink_muted_dark" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/direct_end"
                        style="@style/Widget.Ginga.Button"
                        android:layout_width="wrap_content"
                        android:layout_marginStart="@dimen/ginga_space_4"
                        android:text="@string/direct_end" />
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
