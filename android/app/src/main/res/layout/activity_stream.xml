<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Receives all input: coordinates are normalised against the letterboxed video rect. -->
    <dev.tab2mac.renderer.VideoSurfaceLayout
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
        Before the first frame: the sky (cosmos, #000 in Black espacial), the stars and
        "Transmitindo de <Mac>" in stardust. Gone as soon as video shows, so nothing redraws it.
        Takes no input: touches go to the video below.
    -->
    <FrameLayout
        android:id="@+id/sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/gingaSky"
        android:clickable="false"
        android:focusable="false">

        <dev.tab2mac.receiver.ui.widget.StarfieldView
            android:id="@+id/starfield"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Black espacial only: a dithered black hole (GONE in the other themes). -->
            <dev.tab2mac.receiver.ui.widget.DitherView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ginga_space_6"
                app:ditherColumns="120"
                app:ditherRows="60"
                app:ditherScene="blackHole" />

            <TextView
                android:id="@+id/stream_status"
                style="@style/Ginga.Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ginga_space_8"
                android:layout_marginEnd="@dimen/ginga_space_8"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:textColor="?attr/gingaStardust" />
        </LinearLayout>
    </FrameLayout>

    <!-- The pointer, drawn by the tablet when the Mac sends it as CURSOR (CursorLayer). Takes no input. -->
    <ImageView
        android:id="@+id/cursor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <TextView
        android:id="@+id/overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:background="@color/overlay_background"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:textColor="@color/overlay_text"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- First frame: "Conectado · 60 Hz · Wi‑Fi" for 3 s, then gone. -->
    <dev.tab2mac.receiver.ui.widget.StatusOrbitView
        android:id="@+id/toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="@dimen/ginga_space_3"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />
</FrameLayout>
