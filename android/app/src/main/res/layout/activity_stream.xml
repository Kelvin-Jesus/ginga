<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Receives all input: coordinates are normalised against the letterboxed video rect. -->
    <dev.ginga.renderer.VideoSurfaceLayout
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
        Before the first frame (flows.md, "Stream"): the dithered black hole over cosmos (#000 in
        Black espacial) and a pixel sky, "Transmitindo de <Mac>" in stardust and Conectando….
        Touches here play with the hole (StreamActivity.onSkyTouch) and never reach the Mac. At the
        first frame: a warp while the sky fades, then it is GONE, so nothing draws over the video.
    -->
    <FrameLayout
        android:id="@+id/sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/gingaSky">

        <dev.ginga.receiver.ui.widget.DitherSpaceView
            android:id="@+id/pixel_sky"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:ditherScene="pixelSky" />

        <dev.ginga.receiver.ui.widget.DitherSpaceView
            android:id="@+id/black_hole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="@dimen/ginga_space_12"
            app:ditherColumns="190"
            app:ditherRows="122"
            app:ditherScene="blackHole" />

        <!-- The warp at the first frame (streaks only). -->
        <dev.ginga.receiver.ui.widget.StarfieldView
            android:id="@+id/warp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="@dimen/ginga_space_8"
            android:gravity="bottom"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/stream_status"
                    style="@style/Ginga.Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:textColor="@color/ginga_stardust_dark" />

                <TextView
                    style="@style/Ginga.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ginga_space_1"
                    android:text="@string/stream_sub"
                    android:textColor="@color/ginga_ink_muted_dark" />
            </LinearLayout>

            <dev.ginga.receiver.ui.widget.StatusOrbitView
                android:id="@+id/stream_orbit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ginga_space_4" />
        </LinearLayout>
    </FrameLayout>

    <!-- The pointer, drawn by the tablet when the Mac sends it as CURSOR (CursorLayer). Takes no input. -->
    <ImageView
        android:id="@+id/cursor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <TextView
        android:id="@+id/overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:background="@color/overlay_background"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:textColor="@color/overlay_text"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- First frame: "Conectado · 60 Hz · Wi‑Fi" for 3 s, then gone. -->
    <dev.ginga.receiver.ui.widget.StatusOrbitView
        android:id="@+id/toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="@dimen/ginga_space_3"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />
</FrameLayout>
