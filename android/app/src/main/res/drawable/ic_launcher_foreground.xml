<?xml version="1.0" encoding="utf-8"?>
<!-- Ginga mark "Órbita" (brand/ginga-app-icon.svg): the Mac screen outlined, the tablet tilted
     in front of it, and a star. Mark space is 120 units, scaled by 0.5 and centred so the whole
     mark stays inside the 66 dp adaptive-icon safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.5"
        android:scaleY="0.5"
        android:translateX="24.6"
        android:translateY="27.2">
        <!-- Mac screen -->
        <path
            android:strokeColor="@color/launcher_foreground"
            android:strokeWidth="8"
            android:pathData="M19,22h48a9,9 0,0 1,9 9v30a9,9 0,0 1,-9 9h-48a9,9 0,0 1,-9 -9v-30a9,9 0,0 1,9 -9z" />
        <group
            android:pivotX="78"
            android:pivotY="70"
            android:rotation="-10">
            <!-- Background-coloured gap between the tablet and the screen outline -->
            <path
                android:fillColor="@color/launcher_background"
                android:strokeColor="@color/launcher_background"
                android:strokeWidth="10"
                android:pathData="M59,48h40a9,9 0,0 1,9 9v24a9,9 0,0 1,-9 9h-40a9,9 0,0 1,-9 -9v-24a9,9 0,0 1,9 -9z" />
            <!-- Tablet -->
            <path
                android:fillColor="@color/launcher_foreground"
                android:pathData="M59,48h40a9,9 0,0 1,9 9v24a9,9 0,0 1,-9 9h-40a9,9 0,0 1,-9 -9v-24a9,9 0,0 1,9 -9z" />
        </group>
        <group
            android:translateX="100"
            android:translateY="22">
            <path
                android:fillColor="@color/launcher_star"
                android:pathData="M0,-10C1.2,-2.4 2.4,-1.2 10,0C2.4,1.2 1.2,2.4 0,10C-1.2,2.4 -2.4,1.2 -10,0C-2.4,-1.2 -1.2,-2.4 0,-10Z" />
        </group>
    </group>
</vector>
