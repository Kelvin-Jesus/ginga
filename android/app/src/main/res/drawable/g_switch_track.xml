<?xml version="1.0" encoding="utf-8"?>
<!-- Switch track: cobalt when on; surface-2 outlined by `line` when off. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="@integer/ginga_dur_ui" android:exitFadeDuration="@integer/ginga_dur_ui">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/gingaCobalt" />
            <corners android:radius="@dimen/ginga_radius_pill" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/gingaSurface2" />
            <stroke android:width="1dp" android:color="?attr/gingaLine" />
            <corners android:radius="@dimen/ginga_radius_pill" />
        </shape>
    </item>
</selector>
