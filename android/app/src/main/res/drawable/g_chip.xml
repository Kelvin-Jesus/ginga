<?xml version="1.0" encoding="utf-8"?>
<!-- Method chip: cobalt-soft when selected, outlined by `line` otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="@integer/ginga_dur_ui" android:exitFadeDuration="@integer/ginga_dur_ui">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/gingaCobaltSoft" />
            <corners android:radius="@dimen/ginga_radius_pill" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="?attr/gingaLine" />
            <corners android:radius="@dimen/ginga_radius_pill" />
        </shape>
    </item>
</selector>
