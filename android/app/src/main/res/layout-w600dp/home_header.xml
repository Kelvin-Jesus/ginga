<?xml version="1.0" encoding="utf-8"?>
<!-- Home header, 600dp wide and up (tablets, phones in landscape): monogram + Ginga, the status, Settings, on one line. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:importantForAccessibility="no"
        android:src="?attr/gingaMonogram" />

    <TextView
        style="@style/Ginga.Text.Title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ginga_space_3"
        android:layout_weight="1"
        android:accessibilityHeading="true"
        android:text="@string/app_name" />

    <dev.ginga.receiver.ui.widget.StatusOrbitView
        android:id="@+id/status_orbit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <Button
        android:id="@+id/settings"
        style="@style/Widget.Ginga.Button.Ghost"
        android:layout_width="wrap_content"
        android:layout_marginStart="@dimen/ginga_space_2"
        android:paddingStart="@dimen/ginga_space_4"
        android:paddingEnd="@dimen/ginga_space_4"
        android:text="@string/settings" />
</LinearLayout>
