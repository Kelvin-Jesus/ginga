---
import Base from "../../layouts/Base.astro";
import GingaSite from "../../components/GingaSite.jsx";
import KeynoteTeaser from "../../components/KeynoteTeaser.jsx";
import "../../styles/teaser.css";
import "../../styles/home.css";
import { REPO_URL, RELEASES_URL } from "../../config";
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";
---
<Base lang="en" path="en/" title="Ginga — your Galaxy Tab becomes a Mac display"
  description="Ginga turns a Galaxy Tab into an extended Mac display with touch and S Pen. Direct USB at 120 fps, Wi‑Fi or no router. Free and open source.">
  <a class="skip" href="#recursos">Skip to content</a>
  <KeynoteTeaser client:idle lang="en" base={base} />
  <GingaSite client:load lang="en" base={base} githubUrl={RELEASES_URL} repoUrl={REPO_URL} />
</Base>
