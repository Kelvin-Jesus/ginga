---
import Base from "../../layouts/Base.astro";
import GingaSite from "../../components/GingaSite.jsx";
import KeynoteTeaser from "../../components/KeynoteTeaser.jsx";
import "../../styles/teaser.css";
import "../../styles/home.css";
import { REPO_URL, RELEASES_URL } from "../../config";
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";
---
<Base lang="pt" path="pt/" title="Ginga — seu Galaxy Tab vira tela do Mac"
  description="Ginga transforma um Galaxy Tab em display estendido do Mac com toque e S Pen. USB direto a 120 fps, Wi‑Fi ou sem roteador. Grátis e de código aberto.">
  <a class="skip" href="#recursos">Pular para o conteúdo</a>
  <KeynoteTeaser client:idle lang="pt" base={base} />
  <GingaSite client:load lang="pt" base={base} githubUrl={RELEASES_URL} repoUrl={REPO_URL} />
</Base>
